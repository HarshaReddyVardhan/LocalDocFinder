# Copy to .env in the data folder (next to settings.toml; a .env in any other folder is ignored)
# for local overrides (env vars win over settings.toml).
# Prefix LDF_, nested keys joined with "__". Real secrets (API keys) belong in
# Windows Credential Manager, never in this file.
LDF_LOG_LEVEL=INFO
LDF_OLLAMA_HOST=http://127.0.0.1:11434
LDF_STORAGE__DATA_DIR=
LDF_POWER__REQUIRE_AC_POWER=true
LDF_UPDATES__AUTO_CHECK=true
LDF_UPDATES__REPO_URL=
LDF_APP__START_WITH_WINDOWS=true
