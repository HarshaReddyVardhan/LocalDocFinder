# Copy to .env in the data folder (next to settings.toml; a .env in any other folder is ignored)
# for local overrides (env vars win over settings.toml).
# Prefix VE_, nested keys joined with "__". Real secrets (API keys) belong in
# Windows Credential Manager, never in this file.
VE_LOG_LEVEL=INFO
VE_OLLAMA_HOST=http://127.0.0.1:11434
VE_STORAGE__DATA_DIR=
VE_POWER__REQUIRE_AC_POWER=true
VE_UPDATES__AUTO_CHECK=true
VE_UPDATES__REPO_URL=
VE_APP__START_WITH_WINDOWS=true
